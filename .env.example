# Copy to .env; secrets in .env are ignored by Git.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=dacn
POSTGRES_USER=dacn_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional alternative (percent-encode special characters in credentials):
# DATABASE_URL=postgresql://dacn_app:password@127.0.0.1:5432/dacn
ARTIFACT_ROOT=artifacts
DATA_ROOT=data
RECOMMENDATION_MODEL_VERSION=amazon-medium-v1
